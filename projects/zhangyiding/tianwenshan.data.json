  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta name=\"smc-public\" content=\"true\">\n<script src=\"../../assets/js/auth-check.js\"></script>\n<link rel=\"stylesheet\" href=\"../../assets/css/shared.css\">\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>天问山黄精天猫自营店铺年度运营方案</title>\n<style>\n  * {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n  :root {\n    --primary: #4f46e5;\n    --dark: #312e81;\n    --light: #eef2ff;\n    --light-2: #e0e7ff;\n    --text: #1e1b4b;\n    --text-2: #4b5563;\n    --text-3: #6b7280;\n    --bg: #f8fafc;\n    --white: #ffffff;\n    --shadow: 0 1px 3px rgba(49, 46, 129, .08), 0 4px 12px rgba(49, 46, 129, .06);\n    --shadow-lg: 0 8px 24px rgba(49, 46, 129, .14);\n    --radius: 18px;\n    --radius-sm: 12px;\n  }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Noto Sans SC\", sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    line-height: 1.7;\n    -webkit-font-smoothing: antialiased;\n  }\n  .page {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 32px;\n  }\n\n  /* HERO */\n  .hero {\n    position: relative;\n    background: linear-gradient(135deg, var(--dark) 0%, var(--primary) 100%);\n    color: #fff;\n    text-align: center;\n    padding: 88px 32px 72px;\n    overflow: hidden;\n  }\n  .hero::before {\n    content: '';\n    position: absolute;\n    top: -100px;\n    right: -100px;\n    width: 360px;\n    height: 360px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, .06);\n  }\n  .hero::after {\n    content: '';\n    position: absolute;\n    bottom: -140px;\n    left: -80px;\n    width: 320px;\n    height: 320px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, .04);\n  }\n  .hero-inner {\n    position: relative;\n    z-index: 2;\n    max-width: 900px;\n    margin: 0 auto;\n  }\n  .hero-badge {\n    display: inline-block;\n    background: rgba(255, 255, 255, .15);\n    border: 1px solid rgba(255, 255, 255, .25);\n    border-radius: 999px;\n    padding: 7px 22px;\n    font-size: 13px;\n    letter-spacing: 2px;\n    margin-bottom: 24px;\n    backdrop-filter: blur(6px);\n  }\n  .hero h1 {\n    font-size: 44px;\n    font-weight: 800;\n    letter-spacing: 3px;\n    line-height: 1.3;\n    margin-bottom: 12px;\n    text-shadow: 0 2px 12px rgba(0, 0, 0, .2);\n  }\n  .hero-sub {\n    font-size: 17px;\n    opacity: .85;\n    margin-bottom: 36px;\n    letter-spacing: 1px;\n  }\n  .hero-meta {\n    display: flex;\n    justify-content: center;\n    flex-wrap: wrap;\n    gap: 14px;\n  }\n  .hero-chip {\n    background: rgba(255, 255, 255, .12);\n    border: 1px solid rgba(255, 255, 255, .18);\n    border-radius: 999px;\n    padding: 8px 22px;\n    font-size: 14px;\n    backdrop-filter: blur(4px);\n  }\n  .hero-chip strong {\n    color: #c7d2fe;\n    font-weight: 600;\n  }\n\n  /* SECTION */\n  .section {\n    margin: 64px 0;\n  }\n  .section-header {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    margin-bottom: 32px;\n  }\n  .section-eyebrow {\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 4px;\n    color: var(--primary);\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n  .section-title {\n    font-size: 30px;\n    font-weight: 800;\n    letter-spacing: 2px;\n    white-space: nowrap;\n  }\n  .section-line {\n    flex: 1;\n    height: 2px;\n    background: linear-gradient(90deg, var(--primary), transparent);\n    border-radius: 2px;\n  }\n\n  /* CARDS */\n  .grid-2 {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 24px;\n  }\n  .grid-3 {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n  }\n  .grid-4 {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 24px;\n  }\n  .card {\n    background: var(--white);\n    border-radius: var(--radius);\n    box-shadow: var(--shadow);\n    padding: 28px;\n    transition: transform .25s ease, box-shadow .25s ease;\n  }\n  .card:hover {\n    transform: translateY(-3px);\n    box-shadow: var(--shadow-lg);\n  }\n  .card-icon {\n    width: 46px;\n    height: 46px;\n    border-radius: 12px;\n    background: var(--light);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 20px;\n    margin-bottom: 14px;\n  }\n  .card h4 {\n    font-size: 16px;\n    font-weight: 700;\n    margin-bottom: 8px;\n    color: var(--text);\n  }\n  .card p,\n  .card li {\n    font-size: 14px;\n    color: var(--text-2);\n    line-height: 1.7;\n  }\n  .card .hl {\n    color: var(--primary);\n    font-weight: 700;\n  }\n  .card .big-num {\n    font-size: 32px;\n    font-weight: 800;\n    color: var(--primary);\n    line-height: 1.2;\n  }\n\n  /* OVERVIEW */\n  .overview-grid {\n    display: grid;\n    grid-template-columns: 1.35fr 1fr;\n    gap: 24px;\n  }\n  .overview-card {\n    background: var(--white);\n    border-radius: var(--radius);\n    box-shadow: var(--shadow);\n    padding: 34px;\n    position: relative;\n    overflow: hidden;\n  }\n  .overview-card::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 0;\n    bottom: 0;\n    width: 5px;\n    background: var(--primary);\n    border-radius: 0 4px 4px 0;\n  }\n  .overview-card.challenge::before {\n    background: #f59e0b;\n  }\n  .overview-card h3 {\n    font-size: 18px;\n    font-weight: 700;\n    margin-bottom: 12px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .overview-card p {\n    font-size: 15px;\n    color: var(--text-2);\n  }\n\n  /* DIRECTIVES */\n  .directives-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px;\n  }\n  .directive-card {\n    background: var(--white);\n    border-radius: var(--radius-sm);\n    box-shadow: var(--shadow);\n    padding: 22px;\n    display: flex;\n    gap: 14px;\n    transition: all .25s ease;\n    border-top: 3px solid transparent;\n  }\n  .directive-card:hover {\n    box-shadow: var(--shadow-lg);\n    transform: translateY(-2px);\n    border-top-color: var(--primary);\n  }\n  .directive-num {\n    min-width: 38px;\n    height: 38px;\n    background: var(--light);\n    color: var(--primary);\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 800;\n    font-size: 15px;\n    flex-shrink: 0;\n  }\n  .directive-card h4 {\n    font-size: 15px;\n    font-weight: 700;\n    margin-bottom: 4px;\n  }\n  .directive-card p {\n    font-size: 13px;\n    color: var(--text-2);\n    line-height: 1.55;\n  }\n\n  /* PILLAR */\n  .pillar {\n    background: var(--white);\n    border-radius: 22px;\n    box-shadow: var(--shadow);\n    margin: 44px 0;\n    overflow: hidden;\n    border: 1px solid rgba(79, 70, 229, .06);\n  }\n  .pillar-header {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    padding: 36px 44px 0;\n  }\n  .pillar-num {\n    width: 54px;\n    height: 54px;\n    background: linear-gradient(135deg, var(--primary), var(--dark));\n    color: #fff;\n    border-radius: 16px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 22px;\n    font-weight: 800;\n    flex-shrink: 0;\n    box-shadow: 0 4px 14px rgba(79, 70, 229, .35);\n  }\n  .pillar-title {\n    font-size: 24px;\n    font-weight: 800;\n    letter-spacing: 1px;\n  }\n  .pillar-body {\n    padding: 26px 44px 40px;\n  }\n\n  /* CALLOUT */\n  .callout {\n    background: var(--light);\n    border-left: 5px solid var(--primary);\n    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\n    padding: 20px 28px;\n    font-size: 15px;\n    color: var(--text);\n    font-weight: 500;\n    margin-top: 20px;\n  }\n  .callout strong {\n    color: var(--primary);\n  }\n  .callout.warn {\n    background: #fffbeb;\n    border-left-color: #f59e0b;\n  }\n  .callout.warn strong {\n    color: #b45309;\n  }\n\n  /* PILLAR 1 */\n  .stat-number {\n    font-size: 30px;\n    font-weight: 800;\n    color: var(--primary);\n    line-height: 1.2;\n    display: block;\n    margin-bottom: 4px;\n  }\n\n  /* PILLAR 2 */\n  .segment-card {\n    position: relative;\n    overflow: hidden;\n  }\n  .segment-card::after {\n    content: '';\n    position: absolute;\n    right: -30px;\n    top: -30px;\n    width: 80px;\n    height: 80px;\n    border-radius: 50%;\n    background: var(--light);\n    opacity: .6;\n  }\n  .segment-tag {\n    display: inline-block;\n    background: var(--light);\n    color: var(--primary);\n    font-size: 12px;\n    font-weight: 700;\n    padding: 4px 14px;\n    border-radius: 999px;\n    margin-bottom: 10px;\n  }\n  .key-moment {\n    background: linear-gradient(135deg, var(--dark), var(--primary));\n    color: #fff;\n    border-radius: var(--radius-sm);\n    padding: 24px 32px;\n    text-align: center;\n    font-size: 16px;\n    font-weight: 500;\n    margin-top: 24px;\n    box-shadow: 0 4px 16px rgba(49, 46, 129, .25);\n  }\n  .key-moment strong {\n    color: #c7d2fe;\n  }\n\n  /* PILLAR 3 */\n  .positioning {\n    text-align: center;\n    padding: 32px 20px;\n    border-radius: var(--radius);\n    background: linear-gradient(135deg, var(--light), #ffffff);\n    border: 2px dashed var(--light-2);\n  }\n  .positioning .label {\n    font-size: 13px;\n    letter-spacing: 2px;\n    color: var(--text-3);\n    font-weight: 600;\n    text-transform: uppercase;\n  }\n  .positioning .value {\n    font-size: 32px;\n    font-weight: 800;\n    color: var(--dark);\n    margin-top: 6px;\n    letter-spacing: 2px;\n  }\n  .positioning .slogan {\n    font-size: 18px;\n    color: var(--primary);\n    font-weight: 600;\n    margin-top: 14px;\n  }\n  .trust-card {\n    text-align: center;\n    padding: 24px 16px;\n  }\n  .trust-card .trust-icon {\n    font-size: 28px;\n    margin-bottom: 10px;\n  }\n  .trust-card h5 {\n    font-size: 14px;\n    font-weight: 700;\n    margin-bottom: 4px;\n  }\n  .trust-card p {\n    font-size: 13px;\n    color: var(--text-2);\n  }\n\n  /* PILLAR 4 */\n  .time-block {\n    padding: 24px;\n  }\n  .time-badge {\n    display: inline-block;\n    background: var(--dark);\n    color: #fff;\n    font-size: 13px;\n    font-weight: 700;\n    border-radius: 999px;\n    padding: 4px 18px;\n    margin-bottom: 10px;\n  }\n  .product-table {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0;\n    margin-top: 24px;\n    border-radius: var(--radius-sm);\n    overflow: hidden;\n    box-shadow: var(--shadow);\n  }\n  .product-table th {\n    background: var(--dark);\n    color: #fff;\n    font-size: 14px;\n    font-weight: 700;\n    padding: 14px 18px;\n    text-align: left;\n  }\n  .product-table td {\n    background: #fff;\n    padding: 14px 18px;\n    font-size: 14px;\n    border-bottom: 1px solid #f1f5f9;\n    color: var(--text-2);\n  }\n  .product-table tr:last-child td {\n    border-bottom: none;\n  }\n  .product-table tr:hover td {\n    background: var(--light);\n  }\n  .product-type {\n    font-weight: 700;\n    color: var(--primary);\n  }\n\n  /* PILLAR 5 */\n  .channel-card {\n    padding: 26px;\n  }\n  .channel-icon {\n    font-size: 24px;\n    margin-bottom: 10px;\n  }\n\n  /* PILLAR 6 */\n  .content-pillar-item {\n    padding: 20px;\n  }\n  .story-box {\n    background: linear-gradient(135deg, var(--light), #ffffff);\n    border: 2px dashed var(--light-2);\n    border-radius: var(--radius-sm);\n    padding: 26px 32px;\n    text-align: center;\n    font-size: 16px;\n    font-weight: 600;\n    color: var(--text);\n    margin-bottom: 24px;\n  }\n  .story-box .story-label {\n    font-size: 12px;\n    letter-spacing: 3px;\n    color: var(--text-3);\n    font-weight: 600;\n    text-transform: uppercase;\n    display: block;\n    margin-bottom: 6px;\n  }\n\n  /* PILLAR 7 TIMELINE */\n  .timeline {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 20px;\n    position: relative;\n    margin-top: 28px;\n  }\n  .timeline::before {\n    content: '';\n    position: absolute;\n    top: 28px;\n    left: 12.5%;\n    right: 12.5%;\n    height: 3px;\n    background: linear-gradient(90deg, var(--primary), var(--light-2), var(--primary));\n    border-radius: 3px;\n    z-index: 0;\n  }\n  .phase-card {\n    background: var(--white);\n    border-radius: var(--radius-sm);\n    box-shadow: var(--shadow);\n    padding: 24px;\n    position: relative;\n    z-index: 1;\n    transition: all .25s ease;\n    border-top: 3px solid var(--primary);\n  }\n  .phase-card:hover {\n    box-shadow: var(--shadow-lg);\n    transform: translateY(-3px);\n  }\n  .phase-dot {\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: var(--primary);\n    color: #fff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n    font-weight: 800;\n    margin-bottom: 14px;\n    box-shadow: 0 2px 8px rgba(79, 70, 229, .3);\n  }\n  .phase-time {\n    font-size: 13px;\n    font-weight: 700;\n    color: var(--primary);\n    margin-bottom: 6px;\n  }\n  .phase-name {\n    font-size: 17px;\n    font-weight: 800;\n    margin-bottom: 10px;\n  }\n  .phase-card ul {\n    list-style: none;\n    padding: 0;\n    margin-bottom: 12px;\n  }\n  .phase-card li {\n    font-size: 13px;\n    color: var(--text-2);\n    padding-left: 18px;\n    position: relative;\n    line-height: 1.6;\n    margin-bottom: 4px;\n  }\n  .phase-card li::before {\n    content: '›';\n    position: absolute;\n    left: 2px;\n    color: var(--primary);\n    font-weight: 800;\n    font-size: 16px;\n    line-height: 1.4;\n  }\n  .phase-goal {\n    background: var(--light);\n    border-radius: 8px;\n    padding: 8px 12px;\n    font-size: 12px;\n    font-weight: 600;\n    color: var(--dark);\n    line-height: 1.4;\n  }\n\n  /* PILLAR 8 */\n  .kpi-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 16px;\n    margin-top: 20px;\n  }\n  .kpi-card {\n    background: linear-gradient(135deg, var(--light), #ffffff);\n    border-radius: var(--radius-sm);\n    padding: 20px 16px;\n    text-align: center;\n    border: 1px solid var(--light-2);\n  }\n  .kpi-value {\n    font-size: 24px;\n    font-weight: 800;\n    color: var(--primary);\n    line-height: 1.3;\n    display: block;\n  }\n  .kpi-label {\n    font-size: 12px;\n    color: var(--text-3);\n    margin-top: 6px;\n    font-weight: 600;\n  }\n  .risk-table {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0;\n    margin-top: 24px;\n    border-radius: var(--radius-sm);\n    overflow: hidden;\n    box-shadow: var(--shadow);\n  }\n  .risk-table th {\n    background: var(--dark);\n    color: #fff;\n    font-size: 14px;\n    font-weight: 700;\n    padding: 14px 18px;\n    text-align: left;\n    width: 30%;\n  }\n  .risk-table td {\n    background: #fff;\n    padding: 14px 18px;\n    font-size: 14px;\n    border-bottom: 1px solid #f1f5f9;\n    color: var(--text-2);\n  }\n  .risk-table tr:last-child td {\n    border-bottom: none;\n  }\n  .risk-table tr:hover td {\n    background: var(--light);\n  }\n  .risk-label {\n    font-weight: 700;\n    color: #b45309;\n  }\n\n  /* FOOTER */\n  .footer {\n    background: linear-gradient(135deg, var(--dark), var(--primary));\n    color: rgba(255, 255, 255, .7);\n    text-align: center;\n    padding: 40px 20px;\n    margin-top: 80px;\n    font-size: 14px;\n    letter-spacing: 1px;\n  }\n  .footer strong {\n    color: #fff;\n  }\n\n  /* RESPONSIVE */\n  @media (max-width: 900px) {\n    .grid-2,\n    .grid-3,\n    .grid-4,\n    .overview-grid,\n    .directives-grid,\n    .timeline,\n    .kpi-grid {\n      grid-template-columns: 1fr 1fr;\n    }\n    .pillar-header {\n      padding: 24px 20px 0;\n    }\n    .pillar-body {\n      padding: 16px 20px 28px;\n    }\n    .hero h1 {\n      font-size: 30px;\n    }\n    .timeline::before {\n      display: none;\n    }\n  }\n  @media (max-width: 600px) {\n    .page {\n      padding: 0 16px;\n    }\n    .grid-2,\n    .grid-3,\n    .grid-4,\n    .overview-grid,\n    .directives-grid,\n    .timeline,\n    .kpi-grid {\n      grid-template-columns: 1fr;\n    }\n    .hero {\n      padding: 56px 20px 48px;\n    }\n    .hero h1 {\n      font-size: 24px;\n      letter-spacing: 1px;\n    }\n    .section-title {\n      font-size: 22px;\n    }\n    .pillar-title {\n      font-size: 18px;\n    }\n    .pillar-num {\n      width: 42px;\n      height: 42px;\n      font-size: 18px;\n      border-radius: 12px;\n    }\n    .product-table th,\n    .product-table td,\n    .risk-table th,\n    .risk-table td {\n      padding: 10px 12px;\n      font-size: 13px;\n    }\n  }\n</style>\n</head>\n<body>\n\n  <!-- ===== HERO ===== -->\n  <section class=\"hero\">\n    <div class=\"hero-inner\">\n      <span class=\"hero-badge\">☯ 医疗大健康 · 全域整合营销方案</span>\n      <h1>天问山黄精天猫自营店铺年度运营方案</h1>\n      <p class=\"hero-sub\">以信任定义品类 · 以差异化驱动增长</p>\n      <div class=\"hero-meta\">\n        <span class=\"hero-chip\">🏷 品牌：<strong>天问山</strong></span>\n        <span class=\"hero-chip\">📅 周期：<strong>一年</strong></span>\n        <span class=\"hero-chip\">💰 预算：<strong>¥0</strong></span>\n        <span class=\"hero-chip\">👥 人群：<strong>30岁+女性</strong></span>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"page\">\n\n    <!-- ===== OVERVIEW ===== -->\n    <section class=\"section\" style=\"margin-top:48px;\">\n      <div class=\"section-header\">\n        <span class=\"section-eyebrow\">Overview</span>\n        <span class=\"section-title\">项目概览</span>\n        <div class=\"section-line\"></div>\n      </div>\n      <div class=\"overview-grid\">\n        <div class=\"overview-card\">\n          <h3>📌 项目背景</h3>\n          <p>天问山过往年销量近亿（企业口径），主要依赖达人分销，尚未建立自营店运营能力。现以天猫为切入搭建自营体系；前两个月以黄精果为主推品打基础，价格/规格与达播做差异化、不破价；第三个月起结合天猫平台策略对标喜纯开发新品。</p>\n        </div>\n        <div class=\"overview-card challenge\">\n          <h3>⚡ 核心挑战</h3>\n          <p>自营销售额增长，达人分销保持现状。在<span class=\"hl\">零预算</span>的前提下实现天猫自营从0到1的突破，并逐步建立消费者品牌认知。</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== STRATEGIC DIRECTIVES ===== -->\n    <section class=\"section\">\n      <div class=\"section-header\">\n        <span class=\"section-eyebrow\">Action Plan</span>\n        <span class=\"section-title\">战略行动指令</span>\n        <div class=\"section-line\"></div>\n      </div>\n      <div class=\"directives-grid\">\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">0</div>\n          <div>\n            <h4>财务模型</h4>\n            <p>建立精细化财务模型：产品定价、成本、毛利拆分、盈亏平衡，将月度目标与年度GMV对齐。</p>\n          </div>\n        </div>\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">1</div>\n          <div>\n            <h4>预算分配</h4>\n            <p>分配预估GMV 10-15%做营销、产品开发与团队；若预算为零，则下调销售目标适配。</p>\n          </div>\n        </div>\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">2</div>\n          <div>\n            <h4>路线图修订</h4>\n            <p>Phase1延长至3-4个月夯实基础；新品发布推迟至第5-6个月，待现金流回正后推进。</p>\n          </div>\n        </div>\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">3</div>\n          <div>\n            <h4>资源计划</h4>\n            <p>招聘或合作天猫代运营机构，明确角色分工，设定自营团队搭建时间表。</p>\n          </div>\n        </div>\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">4</div>\n          <div>\n            <h4>数据验证</h4>\n            <p>以权威来源验证市场数据，设置品类领导力里程碑，含竞品对标机制。</p>\n          </div>\n        </div>\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">5</div>\n          <div>\n            <h4>搜索排名</h4>\n            <p>先聚焦长尾关键词与内容扩展，销售验证后再逐步投入付费搜索预算。</p>\n          </div>\n        </div>\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">6</div>\n          <div>\n            <h4>达人资产</h4>\n            <p>利用现有达人内容、KOL名单、客户忠诚度，低成本驱动初期天猫流量。</p>\n          </div>\n        </div>\n        <div class=\"directive-card\">\n          <div class=\"directive-num\">7</div>\n          <div>\n            <h4>应急预算</h4>\n            <p>为合规审查、法律费、产品迭代预留应急预算；Phase1后设「继续/终止」评审。</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== PILLARS ===== -->\n    <section class=\"section\">\n      <div class=\"section-header\">\n        <span class=\"section-eyebrow\">Pillars</span>\n        <span class=\"section-title\">核心策略支柱</span>\n        <div class=\"section-line\"></div>\n      </div>\n\n      <!-- PILLAR 1 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">1</div>\n          <div class=\"pillar-title\">市场洞察</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"grid-3\">\n            <div class=\"card\">\n              <div class=\"card-icon\">📈</div>\n              <h4>市场机会</h4>\n              <p><span class=\"big-num\">3亿+</span>淘系黄精2024年销售额</p>\n              <p style=\"margin-top:6px;\">2025Q1同比 <span class=\"hl\">+25.57%</span></p>\n              <p>黄精成分线上销售同比 <span class=\"hl\">+45.6%</span></p>\n              <p style=\"margin-top:6px;\">品类正从药材向消费品转型，线上小品类高增长。</p>\n            </div>\n            <div class=\"card\">\n              <div class=\"card-icon\">⚔️</div>\n              <h4>竞争格局</h4>\n              <p><strong>南强北弱：</strong>南方产区（九华/新化）和老字号占心智，北方寒地鸡头黄精尚无全国品牌。</p>\n              <p style=\"margin-top:8px;\">竞品山川树以<span class=\"hl\">39%多糖</span>做内容卡位，天问山<span class=\"hl\">48.85%</span>可正面压制。</p>\n            </div>\n            <div class=\"card\">\n              <div class=\"card-icon\">🔬</div>\n              <h4>消费者信任</h4>\n              <p>行业乱象（洋姜冒充/硫熏/工序缩水）频发，买家第一决策障碍是<span class=\"hl\">怕假货</span>。</p>\n              <p style=\"margin-top:8px;\">可验证检测报告 = 最大卖点。</p>\n            </div>\n          </div>\n          <div class=\"callout\">\n            <strong>结论：</strong>天问山应抓住品类定义窗口期，以「寒地 + 高多糖检测」建立信任，在天猫完成从渠道品牌到消费者品牌的跨越。\n          </div>\n        </div>\n      </div>\n\n      <!-- PILLAR 2 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">2</div>\n          <div class=\"pillar-title\">目标人群</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"callout\">\n            <strong>核心人群：</strong>30岁以上女性，有养生意识但缺乏辨别力，愿为安全品质付费。\n          </div>\n          <div class=\"grid-3\" style=\"margin-top:24px;\">\n            <div class=\"card segment-card\">\n              <span class=\"segment-tag\">💼 职场女性 30-40岁</span>\n              <h4>气色 · 精力 · 轻养生</h4>\n              <p>偏好即食/便携产品</p>\n              <p style=\"margin-top:8px;font-size:13px;color:var(--text-3);\">📍 办公室下午茶、早餐代餐</p>\n            </div>\n            <div class=\"card segment-card\">\n              <span class=\"segment-tag\">🏠 熟龄女性 40-55岁</span>\n              <h4>气血 · 睡眠 · 调养</h4>\n              <p>愿为老字号/品质付溢价</p>\n              <p style=\"margin-top:8px;font-size:13px;color:var(--text-3);\">📍 家庭滋补、节日送礼</p>\n            </div>\n            <div class=\"card segment-card\">\n              <span class=\"segment-tag\">📱 尝鲜型 30-45岁</span>\n              <h4>被种草 · 怕踩坑</h4>\n              <p>小红书/短视频种草后搜索攻略</p>\n              <p style=\"margin-top:8px;font-size:13px;color:var(--text-3);\">📍 搜索攻略后购买入门装</p>\n            </div>\n          </div>\n          <div class=\"key-moment\">\n            ⭐ <strong>关键时刻：</strong>第一次搜索「黄精怎么选」「黄精果真假」时，必须让天问山出现在答案里！\n          </div>\n        </div>\n      </div>\n\n      <!-- PILLAR 3 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">3</div>\n          <div class=\"pillar-title\">品牌定位与核心策略</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"positioning\">\n            <span class=\"label\">Brand Positioning</span>\n            <div class=\"value\">寒地鸡头黄精 · 品类定义者</div>\n            <div class=\"slogan\">「 寒地黑土 九蒸九晒 高多糖黄精 」</div>\n          </div>\n          <div class=\"grid-4\" style=\"margin-top:24px;\">\n            <div class=\"card trust-card\">\n              <div class=\"trust-icon\">🧪</div>\n              <h5>高多糖背书</h5>\n              <p>48.85%多糖，第三方检测公证</p>\n            </div>\n            <div class=\"card trust-card\">\n              <div class=\"trust-icon\">🏔️</div>\n              <h5>寒地产区</h5>\n              <p>昼夜温差大、生长周期长</p>\n            </div>\n            <div class=\"card trust-card\">\n              <div class=\"trust-icon\">🔥</div>\n              <h5>九蒸九晒</h5>\n              <p>工艺可视化，对抗工序缩水</p>\n            </div>\n            <div class=\"card trust-card\">\n              <div class=\"trust-icon\">🔗</div>\n              <h5>全链路溯源</h5>\n              <p>从种植到出厂全程可追溯</p>\n            </div>\n          </div>\n          <div class=\"callout\">\n            <strong>核心策略：</strong>自营不做低价跟卖，而做「信任 + 规格差异化」；沿用达播市场认知，但天猫店建立独立的品牌内容、会员与产品体验。\n          </div>\n        </div>\n      </div>\n\n      <!-- PILLAR 4 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">4</div>\n          <div class=\"pillar-title\">产品策略</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"grid-2\">\n            <div class=\"card time-block\">\n              <span class=\"time-badge\">第1-2个月</span>\n              <h4 style=\"margin-bottom:8px;\">主推黄精果</h4>\n              <p>天猫店主打<strong>礼盒装/周期装/组合装</strong>，与达人分销的引流装错位；折合单价不低于达播价，<span class=\"hl\">不破价</span>。</p>\n            </div>\n            <div class=\"card time-block\">\n              <span class=\"time-badge\">第3个月起</span>\n              <h4 style=\"margin-bottom:8px;\">开发新品</h4>\n              <p>对标喜纯开发<span class=\"hl\">即食黄精小方/黄精芝麻丸/便携黄精饮</span>，形成天猫独家SKU，与达播货盘完全区隔。</p>\n            </div>\n          </div>\n          <table class=\"product-table\">\n            <thead>\n              <tr><th>产品类型</th><th>示例</th><th>目的</th></tr>\n            </thead>\n            <tbody>\n              <tr><td class=\"product-type\">引流款</td><td>黄精果小规格尝鲜装</td><td>拉新、起基础销量</td></tr>\n              <tr><td class=\"product-type\">利润款</td><td>黄精果周期装/礼盒装</td><td>核心利润和复购</td></tr>\n              <tr><td class=\"product-type\">形象款</td><td>寒地黄精高端礼盒</td><td>送礼场景、品牌溢价</td></tr>\n              <tr><td class=\"product-type\">新品款</td><td>对标喜纯的即食黄精系列</td><td>差异化、锁定新人群</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <!-- PILLAR 5 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">5</div>\n          <div class=\"pillar-title\">渠道策略</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"grid-4\">\n            <div class=\"card channel-card\">\n              <div class=\"channel-icon\">🏬</div>\n              <h4>天猫自营</h4>\n              <p>主阵地：承接搜索/会员/大促/品牌内容，建立旗舰店资产。</p>\n            </div>\n            <div class=\"card channel-card\">\n              <div class=\"channel-icon\">🎙️</div>\n              <h4>达人分销</h4>\n              <p>维持现状并隔离：主推款/价格/赠品不重叠，保护各渠道利益。</p>\n            </div>\n            <div class=\"card channel-card\">\n              <div class=\"channel-icon\">📕</div>\n              <h4>小红书</h4>\n              <p>种草导流：检测报告+对比实验做「黄精怎么选」搜索卡位；30+女性食养场景，评论/私信引导天猫。</p>\n            </div>\n            <div class=\"card channel-card\">\n              <div class=\"channel-icon\">🚀</div>\n              <h4>未来复制</h4>\n              <p>下半年跑通天猫模型后复制京东/小红书，首年天猫为唯一重点。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- PILLAR 6 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">6</div>\n          <div class=\"pillar-title\">内容与传播策略</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"story-box\">\n            <span class=\"story-label\">Brand Story</span>\n            一棵寒地黄精的旅程：从北纬寒地黑土到九蒸九晒，再到48.85%的检测报告。\n          </div>\n          <div class=\"grid-4\">\n            <div class=\"card content-pillar-item\">\n              <div class=\"card-icon\">🏔️</div>\n              <h4>产地溯源</h4>\n              <p>展示寒地环境，建立「寒地=高品质」认知</p>\n            </div>\n            <div class=\"card content-pillar-item\">\n              <div class=\"card-icon\">🔥</div>\n              <h4>工艺透明</h4>\n              <p>九蒸九晒全过程，对抗工序缩水乱象</p>\n            </div>\n            <div class=\"card content-pillar-item\">\n              <div class=\"card-icon\">🧪</div>\n              <h4>检测背书</h4>\n              <p>详解检测报告+洋姜/硫熏鉴别，解决信任危机</p>\n            </div>\n            <div class=\"card content-pillar-item\">\n              <div class=\"card-icon\">🌿</div>\n              <h4>女性食养</h4>\n              <p>30+女性日常搭配，营造生活方式</p>\n            </div>\n          </div>\n          <div class=\"grid-2\" style=\"margin-top:24px;\">\n            <div class=\"card\">\n              <div class=\"card-icon\">🛍️</div>\n              <h4>天猫内容</h4>\n              <p>详情页 = 信任状集合；逛逛/短视频发鉴别类内容；品牌号做会员内容沉淀。</p>\n            </div>\n            <div class=\"card\">\n              <div class=\"card-icon\">📕</div>\n              <h4>小红书内容</h4>\n              <p>每周5篇笔记 + 2条视频，核心关键词：寒地黄精、黄精果测评、黄精怎么选；优先KOC样品置换，<span class=\"hl\">0预算启动</span>。</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- PILLAR 7 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">7</div>\n          <div class=\"pillar-title\">执行路线图</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"timeline\">\n            <div class=\"phase-card\">\n              <div class=\"phase-dot\">1</div>\n              <div class=\"phase-time\">第1-2个月</div>\n              <div class=\"phase-name\">搭建与启动</div>\n              <ul>\n                <li>完成旗舰店搭建与视觉升级</li>\n                <li>上架黄精果天猫专属规格</li>\n                <li>老客导流/天猫U先/CPS基础销量</li>\n                <li>启动小红书搜索占位</li>\n              </ul>\n              <div class=\"phase-goal\">🎯 月销50万+，评价&买家秀积累，DSR全绿</div>\n            </div>\n            <div class=\"phase-card\">\n              <div class=\"phase-dot\">2</div>\n              <div class=\"phase-time\">第3-6个月</div>\n              <div class=\"phase-name\">新品与放量</div>\n              <ul>\n                <li>开发并上架对标喜纯新品</li>\n                <li>报名天猫健康/滋补品类活动</li>\n                <li>上线周期购/会员日</li>\n                <li>小红书KOC矩阵放量</li>\n              </ul>\n              <div class=\"phase-goal\">🎯 月销150万+，复购率≥20%</div>\n            </div>\n            <div class=\"phase-card\">\n              <div class=\"phase-dot\">3</div>\n              <div class=\"phase-time\">第7-9个月</div>\n              <div class=\"phase-name\">大促蓄水</div>\n              <ul>\n                <li>99/双11蓄水</li>\n                <li>会员私域预热</li>\n                <li>启动店播补充自营直播</li>\n                <li>天猫专属礼盒大促爆发</li>\n              </ul>\n              <div class=\"phase-goal\">🎯 大促单月峰值300万+</div>\n            </div>\n            <div class=\"phase-card\">\n              <div class=\"phase-dot\">4</div>\n              <div class=\"phase-time\">第10-12个月</div>\n              <div class=\"phase-name\">复盘与复制</div>\n              <ul>\n                <li>双11复盘</li>\n                <li>方法论沉淀</li>\n                <li>筹备京东/小红书店复制</li>\n                <li>年货节收官</li>\n              </ul>\n              <div class=\"phase-goal\">🎯 全年GMV 1200-1500万</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- PILLAR 8 -->\n      <div class=\"pillar\">\n        <div class=\"pillar-header\">\n          <div class=\"pillar-num\">8</div>\n          <div class=\"pillar-title\">预算、KPI与风险管理</div>\n        </div>\n        <div class=\"pillar-body\">\n          <div class=\"callout warn\">\n            <strong>预算原则：</strong>预算为0 —— 以自然流量、平台活动、CPS淘客、样品置换、现有达人素材复用为主；若验证可行，建议将自营GMV的<strong>5-8%</strong>投入付费推广。\n          </div>\n          <h4 style=\"margin-top:28px;font-size:16px;font-weight:700;\">📊 KPI 指标体系</h4>\n          <div class=\"kpi-grid\">\n            <div class=\"kpi-card\">\n              <span class=\"kpi-value\">1200-1500万</span>\n              <span class=\"kpi-label\">年度GMV</span>\n            </div>\n            <div class=\"kpi-card\">\n              <span class=\"kpi-value\">50 → 300万</span>\n              <span class=\"kpi-label\">月度GMV阶梯</span>\n            </div>\n            <div class=\"kpi-card\">\n              <span class=\"kpi-value\">5万人<br>25%+</span>\n              <span class=\"kpi-label\">会员数 / 复购率</span>\n            </div>\n            <div class=\"kpi-card\">\n              <span class=\"kpi-value\">前10</span>\n              <span class=\"kpi-label\">「黄精果」搜索排名</span>\n            </div>\n            <div class=\"kpi-card\">\n              <span class=\"kpi-value\">30篇+</span>\n              <span class=\"kpi-label\">小红书占位笔记</span>\n            </div>\n          </div>\n          <h4 style=\"margin-top:28px;font-size:16px;font-weight:700;\">⚠️ 风险管理</h4>\n          <table class=\"risk-table\">\n            <thead>\n              <tr><th>风险</th><th>应对措施</th></tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td class=\"risk-label\">达播价盘冲突</td>\n                <td>天猫专供规格/组合装，不参与达播；任何活动守住最低价红线，用赠品/服务代替降价。</td>\n              </tr>\n              <tr>\n                <td class=\"risk-label\">0预算冷启动慢</td>\n                <td>首月靠老客/私域/CPS破零，同时卡位平台免费活动与搜索长尾词。</td>\n              </tr>\n              <tr>\n                <td class=\"risk-label\">功效宣称违规</td>\n                <td>所有素材过违禁词，只说食养/成分/工艺，不放任何治疗暗示。</td>\n              </tr>\n              <tr>\n                <td class=\"risk-label\">新品开发不及预期</td>\n                <td>提前2个月锁产能，首单小批量测试，根据生意参谋数据快速迭代。</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n    </section>\n  </div>\n\n  <!-- FOOTER -->\n